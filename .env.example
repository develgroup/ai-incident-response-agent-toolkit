# ─────────────────────────────────────────────────────────────────
#   AI Incident Response Toolkit — environment variables
# ─────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
IR_AGENT_MODEL=claude-opus-4-7

# ── Enrichment microservices (Dockerized, see docker-compose.yml) ─
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
MALWAREBAZAAR_API_KEY=
# YARA has no API key — uses local rules in enrichment-agents/yara/rules/

# Enrichment service endpoints (defaults match docker-compose service names)
VIRUSTOTAL_URL=http://localhost:8081
ABUSEIPDB_URL=http://localhost:8082
SHODAN_URL=http://localhost:8083
MALWAREBAZAAR_URL=http://localhost:8084
YARA_URL=http://localhost:8085

# ── AWS (telemetry + staged action) ──────────────────────────────
# Either AWS_PROFILE or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# The IR role declared in config/tenant.example.aws.yaml is what the agent
# assumes once the base credentials are present.
AWS_PROFILE=ir-readonly
AWS_REGION=us-east-1

# ── Azure (telemetry + staged action) ────────────────────────────
# Service principal credentials for the IR principal declared in
# config/tenant.example.azure.yaml. Roles: SecurityReader + AuditLog.Read.All
# + Reports.Read.All + Reader + Microsoft Sentinel Reader.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Sentinel workspace + Defender XDR
AZURE_SENTINEL_WORKSPACE_ID=
AZURE_DEFENDER_TENANT_ID=

# ── Runtime knobs ────────────────────────────────────────────────
IR_AGENT_MAX_ITERATIONS=40
IR_AGENT_LOG_LEVEL=INFO
IR_AGENT_OUTPUT_DIR=./out
